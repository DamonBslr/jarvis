{
  "name": "jarvis",
  "productName": "Jarvis",
  "version": "0.7.1",
  "description": "Local Jarvis-style desktop agent driving Claude Code, Codex CLI and Ollama",
  "author": "DamonBslr",
  "license": "MIT",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p relay/tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "release": "electron-vite build && electron-builder --mac --publish always",
    "icons": "bash scripts/icons.sh",
    "screens": "tsx scripts/screens/shoot.mts"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.85",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "playwright": "1.66.0-alpha-2026-11-09",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  }
}
